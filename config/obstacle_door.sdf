<?xml version="1.0"?>
<!-- Q5.1 (optional case): a 1.4 m panel that blocks the meeting room's only door (0.9 m wide),
     placed with `make block-door`. Static, 0.5 m tall. -->
<sdf version="1.9">
  <model name="door_block">
    <static>true</static>
    <link name="panel">
      <collision name="collision">
        <geometry><box><size>1.4 0.3 0.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.4 0.3 0.5</size></box></geometry>
        <material><ambient>0.8 0.3 0.1 1</ambient><diffuse>0.8 0.3 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
