<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x2_nav</name>
  <version>0.1.0</version>
  <description>Nodes for the SLAM and navigation homework: square driver (Q1.2), goal sender (Q3.2), ground truth (Q4.1), arrival runs (Q4.2).</description>
  <maintainer email="cuycorp@gmail.com">Francesca Camarena</maintainer>
  <license>MIT</license>

  <!-- Q1.2: Python client library and the TwistStamped / Odometry messages used by square_driver -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <!-- Q2.1: LiDAR safety stop and route file in auto_map -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Q3.2: BasicNavigator, to send goals to Nav2 from go_to -->
  <exec_depend>nav2_simple_commander</exec_depend>
  <!-- Q4.1: Gazebo's true poses arrive as TFMessage (ground_truth) -->
  <exec_depend>tf2_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
